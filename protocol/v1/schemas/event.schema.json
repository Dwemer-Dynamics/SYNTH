{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v1/schemas/event.schema.json",
  "title": "SYNTH client event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "type", "session_id", "request_id", "turn_id", "generation", "game", "runtime_variant", "client_version", "runtime_version", "capabilities", "payload"],
  "properties": {
    "schema": {"const": "synth.event.v1"},
    "protocol_version": {"const": 1},
    "type": {"enum": ["init", "input_text", "input_audio", "context", "activate", "trigger", "profile_refresh", "action_result", "cancel", "halt"]},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "turn_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "game": {"const": "fo4"},
    "runtime_variant": {"enum": ["flat", "vr"]},
    "client_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "runtime_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "capabilities": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "not": {"contains": {"enum": ["action.consume_inventory", "action.transfer_inventory", "action.caps_inventory", "action.player_caps_inventory"]}}},
    "payload": {"type": "object", "maxProperties": 64}
  }
}
