{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v1/schemas/visual-context-response.schema.json",
  "title": "SYNTH visual context response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "turn_id", "generation", "capture_id", "ok", "status"],
  "properties": {
    "schema": {"const": "synth.visual_context.response.v1"},
    "request_id": {"type": "string"},
    "turn_id": {"type": "string"},
    "generation": {"type": "integer", "minimum": 0},
    "capture_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "status": {"enum": ["success", "error"]},
    "record_id": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "portrait_media": {"$ref": "media.schema.json"},
    "actor": {"$ref": "identity.schema.json"},
    "code": {"type": "string"},
    "error": {"type": "string"},
    "retryable": {"type": "boolean"},
    "replayed": {"type": "boolean"}
  }
}
