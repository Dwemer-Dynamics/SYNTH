{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/action-result.schema.json",
  "title": "SYNTH action receipt with owned post-action inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action_id",
    "idempotency_key",
    "status",
    "detail",
    "inventory"
  ],
  "properties": {
    "schema": {
      "const": "synth.action.result.v2"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "unavailable",
        "timed_out",
        "cancelled",
        "failed",
        "unsupported_without_esp",
        "unsupported_runtime"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 1024
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "items",
        "observation"
      ],
      "properties": {
        "actor": {
          "$ref": "../../v1/schemas/identity.schema.json"
        },
        "items": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "../../v1/schemas/actor-state.schema.json#/properties/inventory/items"
          }
        },
        "observation": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
