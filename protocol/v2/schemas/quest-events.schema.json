{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/quest-events.schema.json",
  "title": "SYNTH bounded native quest transition batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "form_id",
          "origin_plugin",
          "visibility_sequence",
          "stage",
          "item",
          "failed"
        ],
        "properties": {
          "kind": {
            "enum": [
              "stage",
              "started",
              "stopped"
            ]
          },
          "form_id": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]{8}$",
            "not": {
              "pattern": "^0x(?:00000000|[Ff]{8})$"
            }
          },
          "origin_plugin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\]+\\.(esm|esp|esl)$"
          },
          "visibility_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "item": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "failed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "stage"
                }
              }
            },
            "then": {
              "properties": {
                "failed": {
                  "const": false
                }
              }
            },
            "else": {
              "properties": {
                "stage": {
                  "const": 0
                },
                "item": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
