{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/attack-action.schema.json",
  "title": "Owned flat follower attack against its current visible hostile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action_id",
    "idempotency_key",
    "name",
    "capability",
    "actor",
    "arguments",
    "deadline_ms",
    "target"
  ],
  "properties": {
    "schema": {
      "const": "synth.action.v1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "name": {
      "const": "attack"
    },
    "capability": {
      "const": "action.attack"
    },
    "actor": {
      "allOf": [
        {
          "$ref": "../../v1/schemas/identity.schema.json"
        },
        {
          "properties": {
            "form_id": {
              "not": {
                "enum": [
                  "0x00000014",
                  "0X00000014"
                ]
              }
            }
          }
        }
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 5000
    },
    "target": {
      "allOf": [
        {
          "$ref": "../../v1/schemas/identity.schema.json"
        },
        {
          "properties": {
            "form_id": {
              "not": {
                "enum": [
                  "0x00000014",
                  "0X00000014"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
