{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/status.schema.json",
  "title": "SYNTH v2 status with optional negotiated init acknowledgements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "detail": {
      "type": "string",
      "maxLength": 1024
    },
    "rechat_scene": {
      "type": "boolean"
    },
    "combat_targets": {
      "type": "boolean"
    },
    "ambient_npc": {
      "type": "boolean"
    },
    "combat_contacts": {
      "type": "boolean"
    },
    "enemy_awareness": {
      "type": "boolean"
    },
    "social_tasks": {
      "type": "boolean"
    },
    "native_turn": {
      "type": "boolean"
    },
    "delivery_receipts": {
      "type": "boolean"
    },
    "conversation": {
      "type": "boolean"
    },
    "actor_stats": {
      "type": "boolean"
    },
    "companion_combat_comments": {
      "type": "boolean"
    },
    "location_ancestry": {
      "type": "boolean"
    },
    "location_catalog": {
      "type": "boolean"
    },
    "private_narrator": {
      "type": "boolean"
    },
    "notify_wake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "control_audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "reset_epoch"
      ],
      "properties": {
        "intent": {
          "enum": [
            "normal",
            "everyone"
          ]
        },
        "reset_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "observed_dialogue": {
      "type": "boolean"
    },
    "trade_confirmation": {
      "type": "boolean"
    },
    "actor_condition": {
      "type": "boolean"
    },
    "narrator_object": {
      "type": "boolean"
    },
    "reading_events": {
      "type": "boolean"
    }
  }
}
