{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/response-line.schema.json",
  "title": "SYNTH streamed response line v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "type",
    "line_id",
    "request_id",
    "turn_id",
    "generation",
    "game",
    "runtime_variant",
    "payload",
    "context_sequence"
  ],
  "properties": {
    "schema": {
      "const": "synth.response.line.v2"
    },
    "protocol_version": {
      "const": 2
    },
    "type": {
      "enum": [
        "response_start",
        "dialogue",
        "action",
        "status",
        "response_end"
      ]
    },
    "line_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "game": {
      "const": "fo4"
    },
    "runtime_variant": {
      "enum": [
        "flat",
        "vr"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "rechat_scene": {
          "type": "boolean"
        },
        "listener": {
          "$ref": "../../v1/schemas/identity.schema.json"
        }
      },
      "maxProperties": 64
    },
    "context_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
