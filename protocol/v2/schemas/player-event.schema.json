{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/player-event.schema.json",
  "title": "Owned sampled player transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "before", "after", "interval_ms", "age_ms"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^player:[1-9][0-9]{0,15}$"},
    "kind": {"enum": ["level_up", "combat_end"]},
    "before": {"$ref": "#/$defs/state"},
    "after": {"$ref": "#/$defs/state"},
    "interval_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "age_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "participants": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/participant"}}
  },
  "$defs": {
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["form_id", "origin_plugin", "playthrough_id", "observed_game_time_ticks", "in_combat", "teammate"],
      "properties": {
        "form_id": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
        "origin_plugin": {"type": "string", "minLength": 1, "maxLength": 260},
        "playthrough_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "observed_game_time_ticks": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "in_combat": {"const": true},
        "teammate": {"const": true}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["game_time_ticks", "level", "in_combat"],
      "properties": {
        "game_time_ticks": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "level": {"type": "integer", "minimum": 1, "maximum": 32767},
        "in_combat": {"type": "boolean"}
      }
    }
  },
  "allOf": [{
    "if": {"required": ["participants"]},
    "then": {"properties": {"kind": {"const": "combat_end"}}}
  }, {
    "if": {"properties": {"kind": {"const": "combat_end"}}},
    "then": {"properties": {
      "before": {"properties": {"in_combat": {"const": true}}},
      "after": {"properties": {"in_combat": {"const": false}}}
    }}
  }]
}
