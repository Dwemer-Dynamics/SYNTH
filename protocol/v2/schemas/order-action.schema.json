{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/order-action.schema.json",
  "title": "Owned flat NPC Follow, Stop Following or Take a Seat order bound to its reply line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action_id",
    "idempotency_key",
    "name",
    "capability",
    "actor",
    "arguments",
    "deadline_ms",
    "reply_line_id"
  ],
  "properties": {
    "schema": {
      "const": "synth.action.v1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "name": {
      "enum": [
        "follow_player",
        "stop_following",
        "take_a_seat"
      ]
    },
    "capability": {
      "enum": [
        "action.follow_player",
        "action.stop_following",
        "action.take_a_seat"
      ]
    },
    "actor": {
      "allOf": [
        {
          "$ref": "../../v1/schemas/identity.schema.json"
        },
        {
          "properties": {
            "form_id": {
              "not": {
                "enum": [
                  "0x00000014",
                  "0X00000014"
                ]
              }
            }
          }
        }
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "reply_line_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "follow_player"
          }
        }
      },
      "then": {
        "properties": {
          "capability": {
            "const": "action.follow_player"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "name": {
              "const": "stop_following"
            }
          }
        },
        "then": {
          "properties": {
            "capability": {
              "const": "action.stop_following"
            }
          }
        },
        "else": {
          "properties": {
            "capability": {
              "const": "action.take_a_seat"
            }
          }
        }
      }
    }
  ]
}
