{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/reading-event.schema.json",
  "title": "SYNTH bounded in-game reading (book, note, magazine, holotape, terminal entry) v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "title", "source", "text_truncated", "age_ms"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^reading:[1-9][0-9]{0,15}$"},
    "kind": {"enum": ["book", "magazine", "holotape", "terminal"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_id", "origin_plugin"],
      "properties": {
        "form_id": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$", "not": {"pattern": "^0x(?:00000000|[Ff]{8})$"}},
        "origin_plugin": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+\\.(esm|esp|esl)$"}
      }
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F]+$"},
    "text_truncated": {"type": "boolean"},
    "age_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "allOf": [
    {"if": {"required": ["text"]}, "else": {"properties": {"text_truncated": {"const": false}}}}
  ]
}
