{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synth.local/protocol/v2/schemas/actor-events.schema.json",
  "title": "Owned native actor source evidence, separate from player knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "age_ms",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^actor:[1-9][0-9]{0,15}$"
    },
    "age_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "actor",
          "other_form_id",
          "other_actor",
          "item",
          "original_reference",
          "unique_id",
          "capture_delay_ms",
          "player_knowledge"
        ],
        "properties": {
          "kind": {
            "enum": [
              "death",
              "equipped",
              "unequipped"
            ]
          },
          "actor": {
            "$ref": "#/$defs/identity"
          },
          "other_form_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9A-Fa-f]{8}$",
                "not": {
                  "pattern": "^0x(?:00000000|[Ff]{8})$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "other_actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/identity"
              },
              {
                "type": "null"
              }
            ]
          },
          "item": {
            "anyOf": [
              {
                "$ref": "#/$defs/item"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_reference": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9A-Fa-f]{8}$",
                "not": {
                  "pattern": "^0x(?:00000000|[Ff]{8})$"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "unique_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "capture_delay_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "player_knowledge": {
            "enum": [
              "unavailable",
              "player_equipment"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "death"
                }
              }
            },
            "then": {
              "properties": {
                "item": {
                  "type": "null"
                },
                "original_reference": {
                  "type": "null"
                },
                "unique_id": {
                  "const": 0
                },
                "player_knowledge": {
                  "const": "unavailable"
                }
              }
            },
            "else": {
              "properties": {
                "other_form_id": {
                  "type": "null"
                },
                "other_actor": {
                  "type": "null"
                },
                "item": {
                  "$ref": "#/$defs/item"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "origin_plugin",
        "playthrough_id"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{8}$",
          "not": {
            "pattern": "^0x(?:00000000|[Ff]{8})$"
          }
        },
        "origin_plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+\\.(esm|esp|esl)$"
        },
        "playthrough_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form_id",
        "origin_plugin",
        "display_name",
        "form_type"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{8}$",
          "not": {
            "pattern": "^0x(?:00000000|[Ff]{8})$"
          }
        },
        "origin_plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+\\.(esm|esp|esl)$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "form_type": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    }
  }
}
